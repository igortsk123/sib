[Unit]
Description=Робот-минусовщик Директа — ежечасно, круглосуточно (как крутится реклама)

[Timer]
# Кампании показываются 24/7 (расписание Директа: 100% во все 24 часа, TimeZone Europe/Moscow),
# поэтому и чистка круглосуточная — иначе ночной мусор копится до утра.
# Сервер живёт в Europe/Moscow, systemd берёт локальное время → часовой пояс совпадает с Директом.
OnCalendar=*-*-* *:07:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
