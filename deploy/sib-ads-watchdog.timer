[Unit]
Description=Робот-минусовщик Директа — каждый час в дневное окно (МСК)

[Timer]
# Кампании крутятся круглосуточно, но мусор набирается днём: 08:00–22:00 МСК ежечасно.
# Сервер в UTC (МСК = UTC+3) → 05:00–19:00 UTC.
OnCalendar=*-*-* 05..19:07:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
