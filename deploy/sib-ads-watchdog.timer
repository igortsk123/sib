[Unit]
Description=Робот-минусовщик Директа — раз в 3 часа, круглосуточно

[Timer]
# Кампании показываются 24/7 (расписание Директа: 100% во все 24 часа, TimeZone Europe/Moscow),
# поэтому окно круглосуточное. Частота — раз в 3 часа (решение владельца 12.08): после чистки
# кампании откручиваются медленно (3–4 показа в сутки), новых запросов за час не набирается,
# ежечасный прогон тратил вызов модели впустую на те же остаточные запросы.
# Сервер живёт в Europe/Moscow, systemd берёт локальное время → пояс совпадает с Директом.
OnCalendar=*-*-* 00/3:07:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
